{
  "name": "snapshot_streamed_result_order",
  "description": "Results stream in request order: a chunk of an earlier result after a later one's is a broken stream.",
  "calls": [
    {
      "read": [
        {
          "name": "orders",
          "query": "?order(S, O)"
        },
        {
          "name": "eta",
          "query": "?eta(O, T)"
        }
      ],
      "expect": {
        "error": "internal"
      }
    }
  ],
  "server": [
    {
      "recv": {
        "type": "read",
        "queries": [
          {
            "name": "orders",
            "query": "?order(S, O)"
          },
          {
            "name": "eta",
            "query": "?eta(O, T)"
          }
        ]
      },
      "as": "q"
    },
    {
      "send": {
        "type": "snapshot_start",
        "id": "$q",
        "knowledge_graph": "default",
        "revision": 5,
        "results": [
          {
            "name": "orders",
            "columns": [
              "S",
              "O"
            ],
            "row_count": 1,
            "total_count": 1,
            "truncated": false
          },
          {
            "name": "eta",
            "columns": [
              "O",
              "T"
            ],
            "row_count": 1,
            "total_count": 1,
            "truncated": false
          }
        ],
        "execution_time_ms": 1
      }
    },
    {
      "send": {
        "type": "snapshot_chunk",
        "id": "$q",
        "result": 1,
        "chunk_index": 0,
        "rows": [
          [
            1,
            10
          ]
        ]
      }
    },
    {
      "send": {
        "type": "snapshot_chunk",
        "id": "$q",
        "result": 0,
        "chunk_index": 1,
        "rows": [
          [
            1,
            2
          ]
        ]
      }
    },
    {
      "send": {
        "type": "snapshot_end",
        "id": "$q",
        "chunk_count": 2
      }
    }
  ]
}
