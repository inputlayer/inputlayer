{
  "name": "counts_do_not_add_up",
  "about": "result_end announcing more rows than arrived is not a result.",
  "calls": [
    "?a(X)"
  ],
  "server": [
    {
      "await": {
        "executes": 1
      }
    },
    {
      "send": {
        "type": "result_start",
        "id": "$r0",
        "columns": [
          "x"
        ],
        "total_count": 0,
        "truncated": false,
        "execution_time_ms": 0,
        "errors": []
      }
    },
    {
      "send": {
        "type": "result_chunk",
        "id": "$r0",
        "rows": [
          [
            1
          ]
        ],
        "chunk_index": 0
      }
    },
    {
      "send": {
        "type": "result_end",
        "id": "$r0",
        "row_count": 5,
        "chunk_count": 1
      }
    }
  ],
  "expect": {
    "calls": [
      {
        "error": "InternalError"
      }
    ]
  }
}
