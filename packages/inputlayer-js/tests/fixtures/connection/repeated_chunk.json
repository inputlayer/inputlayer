{
  "name": "repeated_chunk",
  "about": "A chunk index repeated is not a result.",
  "calls": [
    "?a(X)"
  ],
  "server": [
    {
      "await": {
        "executes": 1
      }
    },
    {
      "send": {
        "type": "result_start",
        "id": "$r0",
        "columns": [
          "x"
        ],
        "total_count": 0,
        "truncated": false,
        "execution_time_ms": 0,
        "errors": []
      }
    },
    {
      "send": {
        "type": "result_chunk",
        "id": "$r0",
        "rows": [
          [
            1
          ]
        ],
        "chunk_index": 0
      }
    },
    {
      "send": {
        "type": "result_chunk",
        "id": "$r0",
        "rows": [
          [
            1
          ]
        ],
        "chunk_index": 0
      }
    },
    {
      "send": {
        "type": "result_end",
        "id": "$r0",
        "row_count": 2,
        "chunk_count": 2
      }
    }
  ],
  "expect": {
    "calls": [
      {
        "error": "InternalError"
      }
    ]
  }
}
