{
  "name": "group_subscribe_streamed",
  "about": "A subscription group's snapshot streams like a read's, carrying subscribed in its header; it assembles whole and answers the subscribe.",
  "calls": [
    {
      "subscribe": {
        "subscription": "win",
        "queries": [
          {
            "name": "orders",
            "query": "?order(S, O)"
          },
          {
            "name": "etas",
            "query": "?eta(O, T)"
          }
        ]
      }
    }
  ],
  "server": [
    {
      "await": {
        "executes": 1
      }
    },
    {
      "send": {
        "type": "snapshot_start",
        "id": "$r0",
        "knowledge_graph": "default",
        "revision": 8,
        "results": [
          {
            "name": "orders",
            "columns": [
              "S",
              "O"
            ],
            "row_count": 2,
            "total_count": 2,
            "truncated": false
          },
          {
            "name": "etas",
            "columns": [
              "O",
              "T"
            ],
            "row_count": 0,
            "total_count": 0,
            "truncated": false
          }
        ],
        "execution_time_ms": 0,
        "subscribed": {
          "subscription": "win",
          "generation": 1,
          "revision": 8
        }
      }
    },
    {
      "send": {
        "type": "snapshot_chunk",
        "id": "$r0",
        "result": 0,
        "chunk_index": 0,
        "rows": [
          [
            1,
            10
          ]
        ]
      }
    },
    {
      "send": {
        "type": "snapshot_chunk",
        "id": "$r0",
        "result": 0,
        "chunk_index": 1,
        "rows": [
          [
            2,
            20
          ]
        ]
      }
    },
    {
      "send": {
        "type": "snapshot_end",
        "id": "$r0",
        "chunk_count": 2
      }
    }
  ],
  "expect": {
    "calls": [
      {
        "revision": 8,
        "results": {
          "orders": [
            [
              1,
              10
            ],
            [
              2,
              20
            ]
          ],
          "etas": []
        }
      }
    ],
    "stats": {
      "staleReplies": 0
    }
  }
}
