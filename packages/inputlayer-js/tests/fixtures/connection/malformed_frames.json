          "x"
        ],
        "rows": [
          [
            1
          ]
        ],
        "row_count": 1,
        "total_count": 1,
        "truncated": false,
        "execution_time_ms": 0,
        "errors": []
      }
    }
  ],
  "expect": {
    "calls": [
      {
        "rows": [
          [
            1
          ]
        ]
      }
    ],
    "stats": {
      "malformedFrames": 2
    }
  }
}
