{
  "name": "malformed_frames",
  "about": "Text that is not JSON and a frame of an unknown type are counted and skipped; the connection keeps working.",
  "calls": [
    "?a(X)"
  ],
  "server": [
    {
      "await": {
        "executes": 1
      }
    },
    {
      "raw": "{not json"
    },
    {
      "send": {
        "type": "from_the_future",
        "id": "$r0"
      }
    },
    {
