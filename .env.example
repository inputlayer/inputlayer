# Domain name for TLS certificate (required for production)
DOMAIN=inputlayer.example.com

# Required by both compose files, at least 12 characters each; the engine
# refuses shorter ones on first boot. Generate them with: openssl rand -hex 24
INPUTLAYER_ADMIN_PASSWORD=

# The admin API key the engine issues on first boot; the gateway uses it.
INPUTLAYER_BOOTSTRAP_API_KEY=

# Required: clients of the gateway send it as Authorization: Bearer.
GATEWAY_API_KEY=

# Log level: trace | debug | info | warn | error
INPUTLAYER_LOG_LEVEL=info
